  {
    "name": "hwp_fill_cells",
    "title": "표 셀 채우기",
    "description": "표의 셀 값을 일괄 채웁니다. 각 항목은 좌표 기준({'row': 0, 'col': 1, 'text': '값'}) 또는 라벨 기준({'label': '성명', 'text': '홍길동', 'direction': 'right'|'below'})을 지원합니다. 라벨 기준에서 표 번호('table' 또는 table_index)를 생략하면 모든 표를 앞에서부터 찾아 첫 일치를 씁니다. 좌표 기준에서 표 번호를 생략하면 0번 표입니다. SafeWriter를 통해 스냅샷 백업 및 무손실 검증 후 원자 교체합니다. file_path는 절대 경로 권장.",
    "inputSchema": {
      "properties": {
        "file_path": {
          "title": "File Path",
          "type": "string"
        },
        "cells": {
          "items": {
            "properties": {
              "text": {
                "title": "Text",
                "type": "string"
              },
              "label": {
                "title": "Label",
                "type": "string"
              },
              "direction": {
                "enum": [
                  "right",
                  "below"
                ],
                "title": "Direction",
                "type": "string"
              },
              "occurrence": {
                "title": "Occurrence",
                "type": "integer"
              },
              "row": {
                "title": "Row",
                "type": "integer"
              },
              "col": {
                "title": "Col",
                "type": "integer"
              },
              "table": {
                "title": "Table",
                "type": "integer"
              },
              "keep_style": {
                "title": "Keep Style",
                "type": "boolean"
              }
            },
            "required": [
              "text"
            ],
            "title": "CellInput",
            "type": "object"
          },
          "title": "Cells",
          "type": "array"
        },
        "table_index": {
          "type": "integer",
          "title": "Table Index"
        },
        "expected_sha256": {
          "type": "string",
          "title": "Expected Sha256"
        },
        "force": {
          "default": false,
          "title": "Force",
          "type": "boolean"
        },
        "allow_loss": {
          "default": false,
          "title": "Allow Loss",
          "type": "boolean"
        },
        "password": {
          "type": "string",
          "title": "Password"
        }
      },
      "required": [
        "file_path",
        "cells"
      ],
      "title": "hwp_fill_cellsArguments",
      "type": "object"
    },
    "outputSchema": null,
    "icons": null,
    "annotations": {
      "title": null,
      "readOnlyHint": false,
      "destructiveHint": true,
